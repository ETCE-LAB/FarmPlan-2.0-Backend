meta {
  name: Guest access denied to farms
  type: http
  seq: 3
}

get {
  url: {{gateway_url}}/api/v1/modules/farms/access
  auth: bearer
}

auth:bearer {
  token: {{guest_token}}
}

tests {
  test("guest cannot access a module that requires an account", function() {
    expect(res.getBody().error.code).to.equal("permission_denied");
    expect(res.getStatus()).to.equal(403);
  });
}
