meta {
  name: Registered user access to farms
  type: http
  seq: 4
}

get {
  url: {{gateway_url}}/api/v1/modules/farms/access
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

tests {
  test("registered user can access an enabled module", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().moduleId).to.equal("farms");
    expect(res.getBody().accountType).to.equal("user");
  });
}
