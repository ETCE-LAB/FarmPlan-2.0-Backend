meta {
  name: Register test user
  type: http
  seq: 2
}

script:pre-request {
  bru.setEnvVar("registered_email", "farmplan-" + Date.now() + "@example.test");
  bru.setEnvVar("registered_password", "FarmPlan-local-test-password-2026!");
}

post {
  url: {{gateway_url}}/api/v1/auth/register
  body: json
}

body:json {
  email: "{{registered_email}}"
  password: "{{registered_password}}"
  display_name: "Bruno Test User"
}

tests {
  test("registration creates a user account", function() {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.account_type).to.equal("user");
    expect(body.token_type).to.equal("Bearer");
    expect(body.access_token).to.be.a("string");
    bru.setEnvVar("user_token", body.access_token);
  });
}
