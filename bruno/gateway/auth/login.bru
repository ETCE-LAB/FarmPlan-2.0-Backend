meta {
  name: Login test user
  type: http
  seq: 3
}

post {
  url: {{gateway_url}}/api/v1/auth/login
  body: json
}

body:json {
  email: "{{registered_email}}"
  password: "{{registered_password}}"
}

tests {
  test("registered user can log in", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.account_type).to.equal("user");
    expect(body.access_token).to.be.a("string");
    bru.setEnvVar("user_token", body.access_token);
  });
}
