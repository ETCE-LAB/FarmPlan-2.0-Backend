meta {
  name: Create guest session
  type: http
  seq: 1
}

post {
  url: {{gateway_url}}/api/v1/auth/guest
}

tests {
  test("guest session is anonymous and returns a bearer token", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.account_type).to.equal("guest");
    expect(body.token_type).to.equal("Bearer");
    expect(body.access_token).to.be.a("string");
    bru.setEnvVar("guest_token", body.access_token);
  });
}
