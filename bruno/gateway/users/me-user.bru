meta {
  name: Get registered user profile
  type: http
  seq: 2
}

get {
  url: {{gateway_url}}/api/v1/users/me
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

tests {
  test("user token resolves to the registered profile", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().accountType).to.equal("user");
    expect(res.getBody().email).to.equal(bru.getEnvVar("registered_email"));
  });
}
