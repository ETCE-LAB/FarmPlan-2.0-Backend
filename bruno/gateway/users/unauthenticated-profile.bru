meta {
  name: Reject profile request without token
  type: http
  seq: 3
}

get {
  url: {{gateway_url}}/api/v1/users/me
}

tests {
  test("profile endpoint requires a bearer token", function() {
    expect(res.getBody().error.code).to.equal("unauthenticated");
    expect(res.getStatus()).to.equal(401);
  });
}
