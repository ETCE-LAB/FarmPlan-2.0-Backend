meta {
  name: Change password (disposable account)
  type: http
  seq: 13
}

post {
  url: {{gateway_url}}/api/v1/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

body:json {
  currentPassword: "{{registered_password}}"
  newPassword: "{{new_password}}"
}

tests {
  test("request succeeds", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
