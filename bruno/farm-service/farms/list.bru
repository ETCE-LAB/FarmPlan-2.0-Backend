meta {
  name: List owner farms
  type: http
  seq: 1
}
get {
  url: {{gateway_url}}/api/v1/farms?page=1&pageSize=20
  auth: bearer
}
auth:bearer {
  token: {{user_token}}
}
tests {
  test("paginated direct resources", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().items).to.be.an("array");
    expect(res.getBody().pageSize).to.equal(20);
  });
}
