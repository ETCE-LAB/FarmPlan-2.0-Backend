meta {
  name: Create synthetic field
  type: http
  seq: 2
}
post {
  url: {{gateway_url}}/api/v1/farms/{{farm_id}}/fields
  body: json
  auth: bearer
}
auth:bearer {
  token: {{user_token}}
}
body:json {
  {"name":"Synthetic field","geometry":{"type":"Polygon","coordinates":[[[10,50],[10.001,50],[10.001,50.001],[10,50.001],[10,50]]]},"excludedZones":null,"soilPh":6.5,"irrigation":"drip","autoSpacing":true}
}
tests {
  test("created measured field", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().areaM2).to.be.above(0);
    bru.setVar("field_id", res.getBody().id);
  });
}
